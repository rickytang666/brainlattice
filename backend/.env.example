# Database (SQLite for easy local dev, or Neon / Postgres for production)
DATABASE_URL=sqlite:///./brainlattice.db
# DATABASE_URL=postgres://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 (S3 Compatible Storage)
R2_BUCKET=pdfs
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_S3_API_URL=https://<account_id>.r2.cloudflarestorage.com

# google cloud tasks. leave unset locally to run jobs as in-process background tasks.
# GCP_PROJECT_ID=brainlattice-api
# CLOUD_TASKS_QUEUE=brainlattice-jobs
# CLOUD_TASKS_LOCATION=us-central1
# service account the queue signs dispatches as; the worker rejects anything else
CLOUD_TASKS_INVOKER_SA=
# full url of the worker route, e.g. https://<service>.run.app/worker; also the oidc audience
WORKER_PUBLIC_URL=

# AI API Keys (Optional: ONLY required if running scripts/test_local_pipeline.py)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# clerk auth - required in production so the backend can verify who the caller is.
# find the jwks url in clerk dashboard > api keys > show jwt public key > jwks url.
# without these the backend cannot verify identity and will only accept anonymous sessions.
CLERK_JWKS_URL=https://<your-clerk-subdomain>.clerk.accounts.dev/.well-known/jwks.json
# optional: set explicitly if you don't want it derived from the jwks url
CLERK_ISSUER=

# comma-separated browser origins allowed to call this api. "*" is local-dev only.
CORS_ALLOW_ORIGINS=*
